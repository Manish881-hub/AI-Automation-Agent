OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Default: https://api.openai.com/v1 (leave unset for OpenAI).
# For free OpenRouter models, create a key at https://openrouter.ai
# (no credits needed for :free models) and set:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=<your openrouter key>
# OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Other :free options change over time; pick any text model with a
# ":free" suffix at https://openrouter.ai/models (JSON output preferred).
OPENAI_BASE_URL=https://api.openai.com/v1
ARTIFACT_DIR=./artifacts
CORS_ORIGINS=http://localhost:5173
TEST_EMAIL=test@example.com
TEST_PASSWORD=Test1234!
# Operator authorization for run creation, reads, approval, rejection and
# cancellation. Generate one (python3 -c "import secrets; print(...)") and
# keep it out of git: decisions fail closed without it. The UI trades it
# for a session cookie; API clients send X-Approval-Token.
APPROVAL_TOKEN=
# Untrusted workspace test execution runs in Docker (agent-sandbox image).
# Local host execution is development-only and insecure: leave disabled
# unless Docker is unavailable and you accept the risk.
ALLOW_INSECURE_LOCAL_EXEC=false
# Browser verification launches the workspace server.py on the host. Only
# for the trusted local fixture; set false for untrusted customer code.
TRUST_WORKSPACE_SERVER=true
